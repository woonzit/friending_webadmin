# Server-only Core endpoint. Never prefix this with NEXT_PUBLIC_.
CORE_API_BASE=https://core.freelove.hu

# Must match WEBADMIN_SECRET in the Freelove Core server environment.
WEBADMIN_API_SECRET=replace-with-a-long-random-secret

# Independent HMAC key for the host-only HttpOnly admin session cookie.
# Use at least 32 random bytes; do not reuse WEBADMIN_API_SECRET.
WEBADMIN_SESSION_SECRET=replace-with-an-independent-long-random-secret
