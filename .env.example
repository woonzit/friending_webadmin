# Server-only Core endpoint. Never prefix this with NEXT_PUBLIC_.
CORE_API_BASE=https://core.friending.com

# Must match WEBADMIN_SECRET in the Friending Core server environment.
WEBADMIN_API_SECRET=replace-with-a-long-random-secret

# Independent HMAC key for the host-only HttpOnly admin session cookie.
# Use at least 32 random bytes; do not reuse WEBADMIN_API_SECRET.
WEBADMIN_SESSION_SECRET=replace-with-an-independent-long-random-secret

# Independent, server-only reporting keys for the public marketing sites.
WOONZ_ADMIN_SECRET=replace-with-the-dedicated-woonz-reporting-key
SITE_ANALYTICS_ADMIN_SECRET=replace-with-the-dedicated-friending-site-reporting-key
