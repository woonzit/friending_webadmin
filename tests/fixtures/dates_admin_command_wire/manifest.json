        "wire_adapters": {
            "webadmin_routes": "HTTP POST application/x-www-form-urlencoded -> public/index.php under the PHP web server -> Friending\\Core\\Router::dispatch -> Friending\\Support\\Webadmin::reply"
        },
        "request_encoding": "every request value is a form string, as Webadmin lib/core.ts encodeValue sends it: a boolean \"1\" / \"0\", a number its decimal, no value an empty field, an object one JSON string",
        "released_console": "a request shaped as Webadmin 7825bc13 sends it gets a receipt of exactly the released keys: legal-hold requests without expected_revision (validated with the closed rule of lib/datesModerationRead.ts datesLegalHoldReceipt), trail captures and host transfers without dates_admin_command_contract_version. The admin-*-selected-* bodies are the answers to requests that carry the selector",
        "declared_orchestration": [
            "the two legal-hold cases are closed by a direct storage write before their holds are released (a real resolution would release the automatic hold and change what the hold commands find)",
            "the activity that is purged is soft-deleted twice by the real command; its purge_eligible_at is then moved into the past by a direct storage write, because the retention is thirty days"
        ],
        "cache_policy": {
            "webadmin_routes": "route-default"
        },
        "evaluated_at": 1790000000,
        "normalized_clock_fields": {
            "server_now": "bounded by the request wall clock before replacement",
            "review_at": "exact equality to the requested time, then shift by seed epoch only; null preserved",
            "captured_from/captured_to": "exact equality to the requested bounds, then shift by seed epoch only",
            "expires_at": "the stored transfer expiry, exactly seven days after the stored creation time; replaced by the normalized clock plus seven days",
            "activity_type.updated_at": "exact equality to the stored row; replaced by the normalized clock"
        },
        "normalized_identifier_fields": {
            "audit_id": "top-level only; real aud_32hex of a persisted audit row; numbered by first appearance, so a repeat that names an earlier row keeps that row's number",
            "evidence_id": "top-level only; real evi_32hex of a persisted snapshot; numbered by first appearance",
            "transfer_id": "top-level only; real trf_32hex of a persisted transfer; numbered by first appearance",
            "decision_id": "top-level only; real dec_32hex of the one persisted decision"
        },
